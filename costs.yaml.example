# Teilnehmerliste aller beteiligten Personen
participants:
  - Alice
  - Bob
  - Charlie
  - David
  - Eva

# Liste der Ausgaben
expenses:
  - payer: Alice
    amount: 120.50
    description: "Wocheneinkauf Supermarkt"
    # Wenn 'split_among' fehlt, wird die Summe durch ALLE Teilnehmer geteilt.

  - payer: Bob
    amount: 45.00
    description: "Getränke (Trinkgut)"
    
  - payer: Charlie
    amount: 60.00
    description: "Sprit für den Ausflug"
    # Beispiel für eine Teil-Aufteilung:
    split_among:
      - Alice
      - Charlie
      - David

  - payer: Eva
    amount: 25.00
    description: "Pizza-Bestellung"
    split_among:
      - Eva
      - Bob
      - Charlie

  - payer: David
    amount: 15.00
    description: "Parkgebühren"
